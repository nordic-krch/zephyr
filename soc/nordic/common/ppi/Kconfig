	bool
	depends on $(dt_nodelabel_exists,ppi)
	default y

config NORDIC_DPPI_MULTI_DOMAIN
	bool "DPPI with multiple domains"
	depends on $(dt_has_compat,$(DT_COMPAT_NORDIC_NRF_PPIB))
	default y
endif
